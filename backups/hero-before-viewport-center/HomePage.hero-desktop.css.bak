/* Desktop hero copy only. Keep the existing grid, artwork and <1024px layout. */
@media (min-width: 1024px) {
  .home-hero-copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    max-width: 600px;
    margin-inline: auto;
    text-align: center;
  }

  .home-hero-copy > h1 {
    margin: 0;
  }

  .home-hero-copy > .home-hero-tagline {
    max-width: 100%;
    margin: 16px 0 0;
  }

  .home-hero-copy > .home-hero-description {
    max-width: 560px;
    margin: 24px 0 0;
  }

  .home-hero-copy > .home-hero-trust {
    width: 100%;
    max-width: 100%;
    margin-top: 24px;
  }

  .home-hero-copy .home-hero-rating {
    justify-content: center;
    column-gap: 16px;
    row-gap: 8px;
  }

  .home-hero-copy .home-hero-stats {
    justify-content: center;
    gap: 32px;
    margin-top: 24px;
  }

  .home-hero-copy > .home-hero-primary {
    margin-top: 32px;
  }

  .home-hero-copy > .home-hero-auth {
    justify-content: center;
    gap: 8px;
    margin-top: 16px;
  }

  .home-hero-copy .home-hero-primary > button,
  .home-hero-copy .home-hero-auth > button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    border-radius: 9999px;
  }

  .home-hero-copy .home-hero-primary > button {
    min-height: 56px;
    padding: 16px 32px;
  }

  .home-hero-copy .home-hero-auth > button {
    height: 48px;
    padding: 8px 24px;
  }
}
